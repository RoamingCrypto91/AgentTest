// stdlib/array.rev -- reversible operations on integer arrays.
//
// Every procedure here is a permutation or an accumulation, so every one of
// them can be run backwards with `uncall`.  Array parameters are declared
// `int xs[]` and take their length from the caller.

/// Reverse xs[lo .. hi) in place.  Self-inverse.
/// requires: 0 <= lo && lo <= hi && hi <= len(xs)
proc reverse_range(int xs[], int lo, int hi) {
    local int i = lo;
    local int j = hi - 1;
    from i == lo do {
        if i < j {
            xs[i] <=> xs[j];
        } else {
            skip;
        } fi;
    } loop {
        i += 1;
        j -= 1;
    } until i >= j;
    delocal int j = hi - 1 - (hi - lo) / 2;
    delocal int i = lo + (hi - lo) / 2;
}

/// Reverse the whole array.  Self-inverse.
proc reverse(int xs[]) {
    local int n = len(xs);
    call reverse_range(xs, 0, n);
    delocal int n = len(xs);
}

/// Rotate xs left by k places (k may be negative or larger than the array).
/// `uncall rotate` rotates right by the same amount.
proc rotate(int xs[], int k) {
    local int n = len(xs);
    local int m = ((k % n) + n) % n;
    call reverse_range(xs, 0, m);
    call reverse_range(xs, m, n);
    call reverse_range(xs, 0, n);
    delocal int m = ((k % len(xs)) + len(xs)) % len(xs);
    delocal int n = len(xs);
}

/// Swap two elements.  Self-inverse.
/// requires: 0 <= i && i < len(xs) && 0 <= j && j < len(xs)
proc swap_at(int xs[], int i, int j) {
    xs[i] <=> xs[j];
}

/// acc += the sum of every element.
proc sum_into(int xs[], int acc) {
    local int i = 0;
    from i == 0 do {
        acc += xs[i];
    } loop {
        i += 1;
    } until i == len(xs) - 1;
    delocal int i = len(xs) - 1;
}

/// acc ^= the exclusive-or of every element.  Self-inverse.
proc xor_into(int xs[], int acc) {
    local int i = 0;
    from i == 0 do {
        acc ^= xs[i];
    } loop {
        i += 1;
    } until i == len(xs) - 1;
    delocal int i = len(xs) - 1;
}

/// acc += how many elements equal v.
proc count_into(int xs[], int v, int acc) {
    local int i = 0;
    from i == 0 do {
        if xs[i] == v {
            acc += 1;
        } else {
            skip;
        } fi;
    } loop {
        i += 1;
    } until i == len(xs) - 1;
    delocal int i = len(xs) - 1;
}

/// acc += the largest element.
proc max_into(int xs[], int acc) {
    embed (acc += best) {
        var best = xs[0];
        var i = 1;
        while (i < len(xs)) {
            if (xs[i] > best) {
                best = xs[i];
            }
            i = i + 1;
        }
    }
}

/// ys ^= xs, elementwise.  Self-inverse.  The arrays must be the same length.
/// requires: len(xs) == len(ys)
proc xor_arrays(int xs[], int ys[]) {
    local int i = 0;
    from i == 0 do {
        ys[i] ^= xs[i];
    } loop {
        i += 1;
    } until i == len(xs) - 1;
    delocal int i = len(xs) - 1;
}

/// Add a constant to every element.
proc offset(int xs[], int k) {
    local int i = 0;
    from i == 0 do {
        xs[i] += k;
    } loop {
        i += 1;
    } until i == len(xs) - 1;
    delocal int i = len(xs) - 1;
}
